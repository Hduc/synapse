@baseUrl = http://127.0.0.1:8000
# @baseUrl = https://agriculture-manner-glass-influenced.trycloudflare.com

### 0. System Info & Health
GET {{baseUrl}}/
Accept: application/json

###
GET {{baseUrl}}/health
Accept: application/json


# ==============================================================================
# 1. DECISION & PREDICT ENGINE (System 1 Inference)
# ==============================================================================

### 1.1 Predict Tiêu Chuẩn (Ví dụ khiếu nại hoàn tiền -> Auto trigger Rule Bắn Webhook)
POST {{baseUrl}}/predict
Content-Type: application/json

{
  "state": "Ứng dụng liên tục bị lỗi khi thanh toán, tôi muốn được hoàn tiền lại vào thẻ!",
  "questions": {
    "intent": {
      "type": "choice",
      "instructions": "Xác định nhu cầu chính của khách hàng:",
      "criteria": {
        "refund": "Yêu cầu hoàn tiền hoặc khiếu nại giao dịch",
        "check_system_ram": "Hỏi về tài nguyên RAM máy chủ",
        "check_temperature": "Hỏi về nhiệt độ CPU",
        "other": "Các vấn đề khác"
      }
    },
    "frustrated": {
      "type": "noul",
      "instructions": "Khách hàng có đang cảm thấy bức xúc không?"
    }
  },
  "auto_trigger": true
}

### 1.2 Predict Sự Cố Critical (-> Tự động đưa vào Hàng đợi chờ duyệt /approvals)
POST {{baseUrl}}/predict
Content-Type: application/json

{
  "state": "Ứng dụng bị sập toàn bộ dịch vụ, khách hàng không thể thanh toán được!",
  "questions": {
    "incident_severity": {
      "type": "choice",
      "instructions": "Mức độ nghiêm trọng của sự cố kỹ thuật:",
      "criteria": {
        "critical": "Sự cố nghiêm trọng gây tê liệt dịch vụ",
        "warning": "Cảnh báo hiệu năng suy giảm nhẹ",
        "info": "Thông tin log hệ thống bình thường"
      }
    }
  },
  "auto_trigger": true
}

### 1.3 Predict Coarse-to-Fine Shortlist (Tập lựa chọn lớn, chọn Top-K trước khi chấm điểm)
POST {{baseUrl}}/predict/shortlist
Content-Type: application/json

{
  "state": "Tôi muốn gửi thông báo chấm dứt hợp đồng dịch vụ và đóng tài khoản.",
  "questions": {
    "target_department": {
      "type": "choice",
      "instructions": "Chọn phòng ban tiếp nhận xử lý:",
      "criteria": {
        "finance_invoice": "Kế toán: Thanh toán và hóa đơn đỏ",
        "tech_support": "Kỹ thuật: Hỗ trợ lỗi ứng dụng",
        "contract_cancellation": "Pháp chế & Hợp đồng: Hủy dịch vụ, thanh lý hợp đồng",
        "sales_consult": "Kinh doanh: Mua thêm gói dịch vụ",
        "security_team": "An ninh mạng: Báo cáo hack hoặc rò rỉ dữ liệu",
        "hr_recruitment": "Nhân sự: Ứng tuyển và tuyển dụng",
        "customer_care": "CSKH: Giải đáp thắc mắc thông thường"
      }
    }
  },
  "k": 3,
  "auto_trigger": false
}


