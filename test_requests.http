# ==============================================================================

### 2.1 Danh sách tất cả Presets
GET {{baseUrl}}/presets
Accept: application/json

### 2.2 Xem chi tiết Preset Triage (Customer Support)
GET {{baseUrl}}/presets/triage
Accept: application/json

### 2.3 Xem chi tiết Preset Guard (Bảo vệ AI & Prompt Injection)
GET {{baseUrl}}/presets/guard
Accept: application/json

### 2.4 Xem chi tiết Preset Email
GET {{baseUrl}}/presets/email
Accept: application/json

### 2.5 Xem chi tiết Preset Moderation
GET {{baseUrl}}/presets/moderation
Accept: application/json

### 2.6 Xem chi tiết Preset Router
GET {{baseUrl}}/presets/router
Accept: application/json


# ==============================================================================
# 3. UTILITIES (Làm sạch Email & Phân tích Ngôn ngữ)
# ==============================================================================

### 3.1 Tiền xử lý & Làm sạch Email (bỏ chữ ký, footer, quote history)
POST {{baseUrl}}/utils/clean-email
Content-Type: application/json

{
  "subject": "Yêu cầu hủy gói cước Premium",
  "raw_email": "Chào ban hỗ trợ,\nTôi muốn hủy đăng ký gói dịch vụ từ tháng tới.\n\n--\nNguyễn Hoàng Đức\nMobile: 0901234567\nSent from my iPhone"
}

### 3.2 Phân tích chữ viết, dấu thanh tiếng Việt và độ dài
POST {{baseUrl}}/utils/detect-lang
Content-Type: application/json

{
  "text": "Synapse là hệ thống ra quyết định siêu tốc với độ trễ dưới 20 mili giây."
}


# ==============================================================================
# 4. RULE ENGINE (CRUD & Quản lý quy tắc)
# ==============================================================================

### 4.1 Lấy toàn bộ danh sách Rule
GET {{baseUrl}}/rules
Accept: application/json

### 4.2 Lọc các rule đang kích hoạt
GET {{baseUrl}}/rules?active_only=true
Accept: application/json

### 4.3 Lọc các rule yêu cầu duyệt (require_approval=true)
GET {{baseUrl}}/rules?require_approval_only=true
Accept: application/json

### 4.4 Thêm một Rule mới (Gọi REST API Webhook)
POST {{baseUrl}}/rules
Content-Type: application/json

{
  "name": "Bắn webhook thông báo khiếu nại",
  "description": "Khi phát hiện khiếu nại -> Bắn sang hệ thống bên ngoài",
  "active": true,
  "require_approval": false,
  "trigger": {
    "question_key": "intent",
    "match_choice": "refund",
    "min_confidence": 0.7
  },
  "action": {
    "type": "api",
    "url": "https://httpbin.org/post",
    "method": "POST",
    "headers": {
      "Content-Type": "application/json"
    },
    "auth": {
      "type": "bearer",
      "token": "secret_api_token"
    },
    "json_body": {
      "event": "customer_refund_alert",
      "user_message": "{{context.state}}"
    },
    "timeout": 10
  }
}

### 4.5 Bật/Tắt Rule hoặc chế độ Approval
PATCH {{baseUrl}}/rules/rule_check_ram/toggle?active=true&require_approval=false
Accept: application/json

### 4.6 Xóa một Rule theo ID
DELETE {{baseUrl}}/rules/rule_notify_refund_webhook
Accept: application/json


# ==============================================================================
# 5. APPROVAL WORKFLOW (Hàng đợi phê duyệt)
# ==============================================================================

### 5.1 Xem danh sách tác vụ đang chờ duyệt
GET {{baseUrl}}/approvals
Accept: application/json

### 5.2 Phê duyệt và thực thi ngay lệnh đang chờ (Thay {approval_id} từ kết quả 5.1)
POST {{baseUrl}}/approvals/appr_e3942b1e/approve
Accept: application/json

### 5.3 Từ chối thực thi lệnh đang chờ
POST {{baseUrl}}/approvals/appr_e3942b1e/reject?reason=Nghi_van_bao_dong_gia
Accept: application/json

# ==============================================================================
# 6. COMPONENT CATALOG API (Khai báo UI cho Next.js)
# ==============================================================================

### 6.1 Lấy toàn bộ Component Catalog
GET {{baseUrl}}/components
Accept: application/json

### 6.2 Lọc Component theo module (form, report, task, dashboard)
GET {{baseUrl}}/components?module=form
Accept: application/json

### 6.3 Khai báo thêm một React Component mới vào Catalog
POST {{baseUrl}}/components
Content-Type: application/json

{
  "name": "FeedbackSurveyModal",
  "module": "feedback",
  "title": "Modal Khảo Sát Ý Kiến Người Dùng",
  "description": "Component popup khảo sát mức độ hài lòng CSAT và ý kiến đóng góp",
  "keywords": ["khảo sát", "đánh giá", "góp ý", "feedback", "csat"],
  "props_schema": {
    "title": {"type": "string", "required": true},
    "rating_stars": {"type": "number", "default": 5},
    "comment_required": {"type": "boolean", "default": false}
  },
  "data_binding": {
    "submit_api": "/api/feedback/submit",
    "method": "POST"
  },
  "sample_props": {
    "title": "Đánh giá trải nghiệm dịch vụ",
    "rating_stars": 5,
    "comment_required": false
  }
}


# ==============================================================================
# 7. DATA SOURCES API (Truy xuất Database & Query Templates)
# ==============================================================================

### 7.1 Lấy danh sách Data Sources
GET {{baseUrl}}/datasources
Accept: application/json

### 7.2 Truy xuất dữ liệu từ Data Source (Ví dụ KPI nhân viên)
POST {{baseUrl}}/datasources/ds_employee_kpi/fetch
Content-Type: application/json

{
  "template_key": "top_performers"
}


# ==============================================================================
# 8. TASK MODULE API
# ==============================================================================

### 8.1 Lấy danh sách Task
GET {{baseUrl}}/tasks
Accept: application/json

### 8.2 Tạo Task mới
POST {{baseUrl}}/tasks
Content-Type: application/json

{
  "title": "Tích hợp UI Resolver vào Next.js App",
  "description": "Kết nối API /resolve-ui để tự động render component",
  "assigned_to": "Nguyễn Hoàng Đức",
  "status": "todo",
  "priority": "high",
  "due_date": "2026-09-30"
}


# ==============================================================================
# 9. USER BEHAVIORS API (Theo dõi hành vi người dùng)
# ==============================================================================

### 9.1 Ghi nhận hành vi người dùng
POST {{baseUrl}}/behaviors/log
Content-Type: application/json

{
  "user_id": "user_duc_01",
  "action": "click_submit_registration",
  "module": "form",
  "details": {
    "form_name": "EventRegistrationForm",
    "event_name": "Trung Thu 2026"
  }
}

### 9.2 Xem lịch sử hành vi người dùng
GET {{baseUrl}}/behaviors?limit=20
Accept: application/json


# ==============================================================================
# 10. DYNAMIC UI RESOLVER (Phân tích câu hỏi ra JSON render Next.js)
# ==============================================================================

### 10.1 Tạo form đăng ký sự kiện trung thu
POST {{baseUrl}}/resolve-ui
Content-Type: application/json

{
  "prompt": "tạo form đăng ký sự kiện trung thu",
  "user_id": "user_duc_01",
  "auto_execute_data": true
}

### 10.2 Xem báo cáo ai làm việc hiệu quả
POST {{baseUrl}}/resolve-ui
Content-Type: application/json

{
  "prompt": "xem báo cáo ai làm việc hiệu quả",
  "user_id": "user_duc_01",
  "auto_execute_data": true
}

